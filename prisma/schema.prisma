generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(cuid())
  clerkId            String       @unique
  stripeCustomerId   String?      @unique
  subscriptionStatus String       @default("none")
  credits            Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  generations        Generation[]
  usageLogs          UsageLog[]
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Generation {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  provider  String
  image     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model GalleryItem {
  id        String   @id @default(cuid())
  prompt    String
  image     String
  provider  String
  model     String?
  createdAt DateTime @default(now())

  likes     GalleryLike[]
}

model GalleryLike {
  id            String     @id @default(cuid())
  userId        String
  galleryItemId String
  createdAt     DateTime   @default(now())

  item          GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)

  @@unique([userId, galleryItemId])
  @@index([galleryItemId])
}
